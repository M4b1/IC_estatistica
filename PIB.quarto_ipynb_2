      "source": [
        "#| echo: false\n",
        "#| warning: false\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import seaborn as sns\n",
        "from IPython.display import display\n",
        "\n",
        "# 1. Configurar exibição\n",
        "pd.set_option('display.float_format', lambda x: f'{x:.1f}')\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "plt.rcParams['font.size'] = 11\n",
        "\n",
        "# 2. Carregar o arquivo do SIDRA\n",
        "nome_ficheiro = 'Pib_municipios.csv'\n",
        "\n",
        "try:\n",
        "    df_raw = pd.read_csv(nome_ficheiro, sep=';', encoding='utf-8', skiprows=3)\n",
        "except UnicodeDecodeError:\n",
        "    df_raw = pd.read_csv(nome_ficheiro, sep=';', encoding='latin-1', skiprows=3)\n",
        "\n",
        "# 3. Renomear as duas primeiras colunas\n",
        "df = df_raw.rename(columns={\n",
        "    df_raw.columns[0]: 'codigo_ibge',\n",
        "    df_raw.columns[1]: 'municipio'\n",
        "}).copy()\n",
        "\n",
        "# 4. Limpar código e nome\n",
        "df['codigo_ibge_str'] = df['codigo_ibge'].astype(str).str.extract(r'(\\d+)')[0]\n",
        "df = df[df['codigo_ibge_str'].str.startswith('31') & (df['codigo_ibge_str'].str.len() == 7)].copy()\n",
        "df['codigo_ibge'] = df['codigo_ibge_str'].astype(int)\n",
        "df['municipio'] = df['municipio'].astype(str).str.replace(r'\\s*\\(MG\\)$', '', regex=True).str.strip()\n",
        "\n",
        "# 5. Relação dos 162 municípios oficiais do Sul/Sudoeste\n",
        "municipios_162 = {\n",
        "    # Região Imediata de Passos (14)\n",
        "    'Alpinópolis', 'Bom Jesus da Penha', 'Capetinga', 'Capitólio', 'Cássia',\n",
        "    'Claraval', 'Delfinópolis', 'Fortaleza de Minas', 'Ibiraci', 'Itaú de Minas',\n",
        "    'Passos', 'Pratápolis', 'São João Batista do Glória', 'São José da Barra',\n",
        "\n",
        "    # Região Imediata de São Sebastião do Paraíso (14)\n",
        "    'Arceburgo', 'Cabo Verde', 'Guaranésia', 'Guaxupé', 'Itamogi', 'Jacuí',\n",
        "    'Juruaia', 'Monte Belo', 'Monte Santo de Minas', 'Muzambinho', 'Nova Resende',\n",
        "    'São Pedro da União', 'São Sebastião do Paraíso', 'São Tomás de Aquino',\n",
        "\n",
        "    # Região Imediata de Alfenas (12)\n",
        "    'Alfenas', 'Alterosa', 'Areado', 'Carmo do Rio Claro', 'Carvalhópolis',\n",
        "    'Conceição da Aparecida', 'Divisa Nova', 'Fama', 'Machado', 'Paraguaçu',\n",
        "    'Poço Fundo', 'Serrania',\n",
        "\n",
        "    # Região Imediata de Poços de Caldas (13)\n",
        "    'Albertina', 'Andradas', 'Bandeira do Sul', 'Botelhos', 'Caldas',\n",
        "    'Campestre', 'Ibitiúra de Minas', 'Inconfidentes', 'Jacutinga',\n",
        "    'Monte Sião', 'Ouro Fino', 'Poços de Caldas', 'Santa Rita de Caldas',\n",
        "\n",
        "    # Região Imediata de Pouso Alegre (20)\n",
        "    'Bom Repouso', 'Borda da Mata', 'Bueno Brandão', 'Camanducaia', 'Cambuí',\n",
        "    'Congonhal', 'Córrego do Bom Jesus', 'Espírito Santo do Dourado', 'Estiva',\n",
        "    'Extrema', 'Gonçalves', 'Ipuiúna', 'Itapeva', 'Munhoz', 'Pouso Alegre',\n",
        "    'Sapucaí-Mirim', 'Senador Amaral', 'Senador José Bento', 'Tocos do Moji', 'Toledo',\n",
        "\n",
        "    # Região Imediata de Santa Rita do Sapucaí (15)\n",
        "    'Cachoeira de Minas', 'Careaçu', 'Conceição das Pedras', 'Conceição dos Ouros',\n",
        "    'Cordislândia', 'Heliodora', 'Natércia', 'Pedralva', 'Piranguinho',\n",
        "    'Santa Rita do Sapucaí', 'São João da Mata', 'São José do Alegre',\n",
        "    'São Sebastião da Bela Vista', 'Silvianópolis', 'Turvolândia',\n",
        "\n",
        "    # Região Imediata de Itajubá (13)\n",
        "    'Brazópolis', 'Consolação', 'Cristina', 'Delfim Moreira', 'Dom Viçoso',\n",
        "    'Itajubá', 'Maria da Fé', 'Marmelópolis', 'Paraisópolis', 'Piranguçu',\n",
        "    'São Lourenço', 'São Sebastião do Rio Verde', 'Wenceslau Braz',\n",
        "\n",
        "    # Região Imediata de Varginha (16)\n",
        "    'Boa Esperança', 'Campanha', 'Campo do Meio', 'Campos Gerais', 'Carmo da Cachoeira',\n",
        "    'Coqueiral', 'Elói Mendes', 'Guapé', 'Ilicínea', 'Monsenhor Paulo',\n",
        "    'Santana da Vargem', 'São Bento Abade', 'São Gonçalo do Sapucaí',\n",
        "    'Três Corações', 'Três Pontas', 'Varginha',\n",
        "\n",
        "    # Região Imediata de São Lourenço (16)\n",
        "    'Alagoa', 'Baependi', 'Cambuquira', 'Carmo de Minas', 'Caxambu',\n",
        "    'Conceição do Rio Verde', 'Itamonte', 'Itanhandu', 'Jesuânia', 'Lambari',\n",
        "    'Olímpio Noronha', 'Passa Quatro', 'Pouso Alto', 'São Tomé das Letras',\n",
        "    'Soledade de Minas', 'Virgínia',\n",
        "\n",
        "    # Região Imediata de Andrelândia (13)\n",
        "    'Aiuruoca', 'Andrelândia', 'Arantina', 'Bocaina de Minas', 'Bom Jardim de Minas',\n",
        "    'Carvalhos', 'Cruzília', 'Liberdade', 'Minduri', 'Passa Vinte',\n",
        "    'São Vicente de Minas', 'Seritinga', 'Serranos',\n",
        "\n",
        "    # Região Imediata de Lavras (9)\n",
        "    'Carrancas', 'Ijaci', 'Ingaí', 'Itumirim', 'Itutinga', 'Lavras',\n",
        "    'Luminárias', 'Nepomuceno', 'Ribeirão Vermelho',\n",
        "\n",
        "    # Região Imediata de Campo Belo (7)\n",
        "    'Aguanil', 'Campo Belo', 'Cana Verde', 'Candeias', 'Cristais',\n",
        "    'Perdões', 'Santana do Jacaré'\n",
        "}\n",
        "\n",
        "# 6. Filtrar os municípios na base\n",
        "df_sul = df[df['municipio'].isin(municipios_162)].copy()\n",
        "\n",
        "# 7. Identificar anos (2010 a 2021) e converter valores para Milhões de Reais\n",
        "anos = [str(y) for y in range(2010, 2022)]\n",
        "for ano in anos:\n",
        "    if ano in df_sul.columns:\n",
        "        valor = df_sul[ano].astype(str).str.replace('.', '', regex=False).str.replace(',', '.', regex=False)\n",
        "        df_sul[f'pib_{ano}_milhoes_reais'] = (pd.to_numeric(valor, errors='coerce') / 1000).round(1)\n",
        "\n",
        "# 8. Montar a tabela final\n",
        "colunas_finais = ['codigo_ibge', 'municipio'] + [f'pib_{ano}_milhoes_reais' for ano in anos if ano in df_sul.columns]\n",
        "df_pib_final = df_sul[colunas_finais].reset_index(drop=True)\n",
        "\n",
        "#| echo: false\n",
        "#| warning: false\n",
        "#| message: false\n",
        "\n",
        "# 1. Calcular posições no ranking para 2010 e 2021\n",
        "df_pib_final['posicao_2010'] = df_pib_final['pib_2010_milhoes_reais'].rank(ascending=False, method='min').astype(int)\n",
        "df_pib_final['posicao_2021'] = df_pib_final['pib_2021_milhoes_reais'].rank(ascending=False, method='min').astype(int)\n",
        "\n",
        "# 2. Variação no ranking (positivo = subiu no ranking; negativo = caiu)\n",
        "df_pib_final['variacao_posicao'] = df_pib_final['posicao_2010'] - df_pib_final['posicao_2021']\n",
        "\n",
        "# 3. Crescimento acumulado percentual (2010 a 2021)\n",
        "df_pib_final['crescimento_acumulado_pct'] = (\n",
        "    ((df_pib_final['pib_2021_milhoes_reais'] - df_pib_final['pib_2010_milhoes_reais']) / df_pib_final['pib_2010_milhoes_reais']) * 100\n",
        ").round(2)\n",
        "\n",
        "# 4. Tabela ordenada pelas maiores economias de 2021\n",
        "colunas_ranking = [\n",
        "    'municipio',\n",
        "    'posicao_2010',\n",
        "    'posicao_2021',\n",
        "    'variacao_posicao',\n",
        "    'pib_2010_milhoes_reais',\n",
        "    'pib_2021_milhoes_reais',\n",
        "    'crescimento_acumulado_pct'\n",
        "]\n",
        "\n",
        "df_ranking_exibicao = df_pib_final[colunas_ranking].sort_values(by='posicao_2021').reset_index(drop=True)\n",
        "\n",
        "display(df_ranking_exibicao.head(10))\n",
        "\n",
        "#| echo: false\n",
        "#| warning: false\n",
        "#| message: false\n",
        "\n",
        "# Top 10 cidades com maior crescimento relativo\n",
        "top_crescimento = df_pib_final.sort_values(by='crescimento_acumulado_pct', ascending=True).tail(10)\n",
        "\n",
        "plt.figure(figsize=(10, 5))\n",
        "barras = plt.barh(top_crescimento['municipio'], top_crescimento['crescimento_acumulado_pct'], color='#2ca02c')\n",
        "\n",
        "for barra in barras:\n",
        "    w = barra.get_width()\n",
        "    plt.text(w + 5, barra.get_y() + barra.get_height() / 2, f'+{w:.1f}%', \n",
        "             va='center', ha='left', fontweight='bold', color='#222222', fontsize=10)\n",
        "\n",
        "plt.title('Top 10 Municípios com Maior Crescimento Acumulado do PIB (2010–2021)', fontsize=13, fontweight='bold', pad=12)\n",
        "plt.xlabel('Crescimento Nominal (%)', fontsize=11)\n",
        "plt.ylabel('Município', fontsize=11)\n",
        "plt.xlim(0, top_crescimento['crescimento_acumulado_pct'].max() * 1.15)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "#| echo: false\n",
        "#| warning: false\n",
        "#| message: false\n",
        "\n",
        "# ==============================================================================\n",
        "# GRÁFICO 1: Top 10 Maiores Economias em 2021 (Barras Horizontais Azuis)\n",
        "# ==============================================================================\n",
        "top10 = (\n",
        "    df_pib_final\n",
        "    .sort_values(by='pib_2021_milhoes_reais', ascending=False)\n",
        "    .head(10)\n",
        "    .sort_values(by='pib_2021_milhoes_reais', ascending=True)\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "barras = plt.barh(top10['municipio'], top10['pib_2021_milhoes_reais'], color='#2b5c8f')\n",
        "\n",
        "for barra in barras:\n",
        "    largura = barra.get_width()\n",
        "    plt.text(largura + 250, barra.get_y() + barra.get_height() / 2,\n",
        "             f'R$ {largura:,.1f} mi',\n",
        "             va='center', ha='left', fontsize=10, fontweight='bold', color='#333333')\n",
        "\n",
        "plt.title('Top 10 Maiores Economias do Sul/Sudoeste de Minas (PIB 2021)', fontsize=14, fontweight='bold', pad=15)\n",
        "plt.xlabel('PIB em Milhões de Reais (R$ mi)', fontsize=12)\n",
        "plt.ylabel('Município', fontsize=12)\n",
        "plt.xlim(0, top10['pib_2021_milhoes_reais'].max() * 1.18)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ==============================================================================\n",
        "# GRÁFICO 2: Evolução Histórica (2010 a 2021) dos Municípios Líderes\n",
        "# ==============================================================================\n",
        "anos_cols = [f'pib_{ano}_milhoes_reais' for ano in range(2010, 2022)]\n",
        "rotulos_anos = [str(ano) for ano in range(2010, 2022)]\n",
        "\n",
        "top5 = df_pib_final.sort_values(by='pib_2021_milhoes_reais', ascending=False).head(5)\n",
        "\n",
        "plt.figure(figsize=(11, 6))\n",
        "for _, linha in top5.iterrows():\n",
        "    plt.plot(rotulos_anos, linha[anos_cols], marker='o', linewidth=2.5, label=linha['municipio'])\n",
        "\n",
        "plt.title('Trajetória de Crescimento do PIB (2010–2021) — Principais Cidades', fontsize=14, fontweight='bold', pad=15)\n",
        "plt.xlabel('Ano', fontsize=12)\n",
        "plt.ylabel('PIB (Milhões de R$)', fontsize=12)\n",
        "plt.xticks(rotation=45)\n",
        "plt.legend(title='Município', bbox_to_anchor=(1.02, 1), loc='upper left', frameon=True)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "#| echo: false\n",
        "#| warning: false\n",
        "#| message: false\n",
        "\n",
        "cidades_alvo = ['São Sebastião do Paraíso', 'Passos', 'Alfenas', 'Varginha', 'Pouso Alegre']\n",
        "\n",
        "# 1. Filtrar as cidades selecionadas mantendo a ordem da lista\n",
        "df_comp = df_pib_final[df_pib_final['municipio'].isin(cidades_alvo)].copy()\n",
        "df_comp['municipio'] = pd.Categorical(df_comp['municipio'], categories=cidades_alvo, ordered=True)\n",
        "df_comp = df_comp.sort_values('municipio').reset_index(drop=True)\n",
        "\n",
        "# 2. Calcular o crescimento percentual (2010 vs 2021)\n",
        "df_comp['crescimento_pct'] = (\n",
        "    ((df_comp['pib_2021_milhoes_reais'] - df_comp['pib_2010_milhoes_reais']) / df_comp['pib_2010_milhoes_reais']) * 100\n",
        ")\n",
        "\n",
        "# 3. Posições para 3 colunas por cidade\n",
        "x = np.arange(len(df_comp))\n",
        "largura = 0.25\n",
        "\n",
        "fig, ax1 = plt.subplots(figsize=(11, 6))\n",
        "\n",
        "# Coluna 1: PIB 2010 | Coluna 2: PIB 2021 (Eixo Principal - R$ Milhões)\n",
        "b1 = ax1.bar(x - largura, df_comp['pib_2010_milhoes_reais'], largura, label='PIB 2010 (R$ mi)', color='#7293cb')\n",
        "b2 = ax1.bar(x, df_comp['pib_2021_milhoes_reais'], largura, label='PIB 2021 (R$ mi)', color='#e1974c')\n",
        "\n",
        "ax1.set_ylabel('PIB em Milhões de Reais (R$ mi)', fontsize=12)\n",
        "ax1.set_ylim(0, df_comp['pib_2021_milhoes_reais'].max() * 1.18)\n",
        "\n",
        "# Coluna 3: Crescimento % (Eixo Secundário à Direita)\n",
        "ax2 = ax1.twinx()\n",
        "b3 = ax2.bar(x + largura, df_comp['crescimento_pct'], largura, label='Crescimento (%)', color='#2ca02c')\n",
        "\n",
        "ax2.set_ylabel('Crescimento Acumulado (%)', fontsize=12, color='#2ca02c', fontweight='bold')\n",
        "ax2.tick_params(axis='y', labelcolor='#2ca02c')\n",
        "ax2.set_ylim(0, df_comp['crescimento_pct'].max() * 1.25)\n",
        "ax2.grid(False)\n",
        "\n",
        "# 4. Adicionar o valor percentual acima da terceira coluna\n",
        "for barra in b3:\n",
        "    altura = barra.get_height()\n",
        "    ax2.text(\n",
        "        barra.get_x() + barra.get_width() / 2,\n",
        "        altura + (altura * 0.02),\n",
        "        f'+{altura:.1f}%',\n",
        "        ha='center',\n",
        "        va='bottom',\n",
        "        fontsize=9,\n",
        "        fontweight='bold',\n",
        "        color='#1b611b'\n",
        "    )\n",
        "\n",
        "# Configuração dos eixos e legenda unificada\n",
        "ax1.set_xticks(x)\n",
        "ax1.set_xticklabels(df_comp['municipio'], rotation=15, fontsize=11)\n",
        "plt.title('Comparativo de PIB (2010 vs 2021) e Ritmo de Crescimento (%)', fontsize=13, fontweight='bold', pad=15)\n",
        "\n",
        "linhas = [b1, b2, b3]\n",
        "rotulos = [l.get_label() for l in linhas]\n",
        "ax1.legend(linhas, rotulos, loc='upper left', frameon=True)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
