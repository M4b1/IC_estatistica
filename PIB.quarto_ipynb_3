      "source": [
        "#| echo: false\n",
        "#| warning: false\n",
        "\n",
        "#| echo: false\n",
        "#| warning: false\n",
        "#| message: false\n",
        "\n",
        "def carregar_serie_ipea(caminho_csv, nome_var):\n",
        "    # 1. Leitura saltando a primeira linha de título descritivo do IPEAdata\n",
        "    try:\n",
        "        df = pd.read_csv(caminho_csv, sep=';', encoding='utf-8-sig', skiprows=1)\n",
        "    except UnicodeDecodeError:\n",
        "        df = pd.read_csv(caminho_csv, sep=';', encoding='latin-1', skiprows=1)\n",
        "\n",
        "    # Limpar espaços em branco nos cabeçalhos das colunas\n",
        "    df.columns = [str(c).strip() for c in df.columns]\n",
        "\n",
        "    # 2. Renomear pelas posições fixas:\n",
        "    # Índice 1 é o Código IBGE e Índice 2 é o Município\n",
        "    df = df.rename(columns={\n",
        "        df.columns[1]: 'codigo_ibge',\n",
        "        df.columns[2]: 'municipio'\n",
        "    })\n",
        "\n",
        "    # 3. Limpeza textual e filtragem para os 162 municípios oficiais\n",
        "    df['municipio'] = df['municipio'].astype(str).str.replace(r'\\s*\\(MG\\)$', '', regex=True).str.strip()\n",
        "    df = df[df['municipio'].isin(municipios_162)].copy()\n",
        "\n",
        "    # 4. Tratamento das colunas de anos (2010 a 2021)\n",
        "    colunas_anos = [c for c in df.columns if any(str(ano) == str(c) for ano in range(2010, 2022))]\n",
        "    \n",
        "    for c in colunas_anos:\n",
        "        df[c] = df[c].astype(str).str.strip()\n",
        "        # Remove eventuais separadores de milhar e converte vírgula decimal em ponto\n",
        "        df[c] = df[c].str.replace('.', '', regex=False).str.replace(',', '.', regex=False)\n",
        "        df[c] = pd.to_numeric(df[c], errors='coerce')\n",
        "\n",
        "    # 5. Prefixo da variável correspondente\n",
        "    mapa_renomear = {c: f\"{nome_var}_{c}\" for c in colunas_anos}\n",
        "    df = df.rename(columns=mapa_renomear)\n",
        "\n",
        "    colunas_finais = ['codigo_ibge', 'municipio'] + list(mapa_renomear.values())\n",
        "    return df[colunas_finais].reset_index(drop=True)\n",
        "\n",
        "# 1. Carregamento das 5 séries oficiais de Contas Regionais\n",
        "df_pib_ipea  = carregar_serie_ipea('ipeadata(pib municipal).csv', 'pib_total')\n",
        "df_agro_ipea = carregar_serie_ipea('ipeadata(Vab_agro).csv', 'vab_agro')\n",
        "df_ind_ipea  = carregar_serie_ipea('ipeadata(vab_industria).csv', 'vab_industria')\n",
        "df_serv_ipea = carregar_serie_ipea('ipeadata(vab_servicos_priv_mg).csv', 'vab_servicos')\n",
        "df_adm_ipea  = carregar_serie_ipea('ipeadata(vab_adm_publica).csv', 'vab_adm_publica')\n",
        "\n",
        "# 2. Cruzamento relacional (Merge das 5 bases)\n",
        "df_setorial = (\n",
        "    df_pib_ipea\n",
        "    .merge(df_agro_ipea, on=['codigo_ibge', 'municipio'])\n",
        "    .merge(df_ind_ipea, on=['codigo_ibge', 'municipio'])\n",
        "    .merge(df_serv_ipea, on=['codigo_ibge', 'municipio'])\n",
        "    .merge(df_adm_ipea, on=['codigo_ibge', 'municipio'])\n",
        ")\n",
        "\n",
